<view class="container">
  <!-- 头部信息 -->
  <view class="header">
    <view class="header-top">
      <text class="emoji">{{activity.emoji}}</text>
      <view class="header-info">
        <view class="user-row">
          <text class="user-avatar">{{activity.userAvatar}}</text>
          <text class="username">{{activity.username}}</text>
        </view>
        <view class="meta-row">
          <text class="type-tag">{{activity.type}}</text>
          <text class="status-tag {{activity.status === '已满员' ? 'full' : 'active'}}">{{activity.status}}</text>
        </view>
      </view>
    </view>
    <text class="title">{{activity.title}}</text>
  </view>

  <!-- 基本信息卡片 -->
  <view class="info-card">
    <view class="info-item">
      <text class="info-icon">📍</text>
      <view class="info-content">
        <text class="info-label">活动地点</text>
        <text class="info-value">{{activity.address}}</text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-icon">🕐</text>
      <view class="info-content">
        <text class="info-label">活动时间</text>
        <text class="info-value">{{activity.time}}</text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-icon">👥</text>
      <view class="info-content">
        <text class="info-label">参与人数</text>
        <text class="info-value">{{activity.people}}人</text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-icon">📍</text>
      <view class="info-content">
        <text class="info-label">所在地区</text>
        <text class="info-value">{{activity.location}}</text>
      </view>
    </view>
  </view>

  <!-- 活动描述 -->
  <view class="section">
    <text class="section-title">活动详情</text>
    <view class="desc-card">
      <text class="desc-text">{{activity.description}}</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="section">
    <text class="section-title">相关标签</text>
    <view class="tags">
      <text wx:for="{{activity.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
  </view>

  <!-- 已参与用户 -->
  <view class="section" wx:if="{{participants.length > 0}}">
    <text class="section-title">已参与 ({{participants.length}})</text>
    <view class="participants">
      <view wx:for="{{participants}}" wx:key="index" class="participant">
        <text class="p-avatar">{{item.avatar}}</text>
        <text class="p-name">{{item.name}}</text>
        <text class="p-time">{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="join-btn {{hasJoined ? 'joined' : ''}}" bindtap="joinActivity">
      {{hasJoined ? '✓ 已报名' : '立即报名'}}
    </view>
  </view>

  <!-- 评价入口 -->
  <view class="review-entry" wx:if="{{hasJoined}}">
    <text class="review-entry-text">已参加活动？去评价</text>
    <button class="review-entry-btn" bindtap="goToReview" data-id="{{activity.id}}" data-name="{{activity.title}}">去评价</button>
  </view>

  <!-- 评论入口 -->
  <view class="comment-entry">
    <text class="comment-entry-text">💬 参与讨论 ({{commentCount || 0}})</text>
    <button class="comment-entry-btn" bindtap="goToComment" data-id="{{activity.id}}" data-title="{{activity.title}}">去评论</button>
  </view>
</view>
