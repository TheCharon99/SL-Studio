<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">📬 消息</text>
    <text class="subtitle">{{unreadCount > 0 ? unreadCount + '条未读' : '暂无新消息'}}</text>
  </view>

  <!-- 操作栏 -->
  <view class="actions" wx:if="{{messages.length > 0}}">
    <button class="action-btn" bindtap="handleClearAll">清空所有</button>
  </view>

  <!-- 消息列表 -->
  <view class="list">
    <view 
      wx:for="{{messages}}" 
      wx:key="id"
      class="message-item {{item.read ? '' : 'unread'}}"
      bindtap="handleMessage"
      data-id="{{item.id}}"
    >
      <view class="msg-icon">{{item.icon}}</view>
      <view class="msg-content">
        <view class="msg-header">
          <text class="msg-title">{{item.title}}</text>
          <text class="msg-time">{{item.time}}</text>
        </view>
        <text class="msg-text">{{item.content}}</text>
      </view>
      <view class="msg-action">
        <text class="delete-btn" data-id="{{item.id}}" bindtap="handleDelete">×</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{messages.length === 0}}" class="empty">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无消息</text>
    <text class="empty-hint">有新动态时会在这里通知你</text>
  </view>
</view>
