/* 评价页样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 评分区域 */
.rating-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rating-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.star {
  font-size: 56rpx;
  color: #e0e0e0;
  transition: all 0.2s;
}

.star.active {
  color: #FFB800;
}

.rating-text {
  font-size: 26rpx;
  color: #999;
}

/* 评价表单 */
.section {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 标签选择 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
}

.tag.selected {
  background: #E8F5E9;
  color: #00C853;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 提交按钮 */
.submit-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.submit-btn::after {
  border: none;
}

.cancel-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #999;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 2rpx solid #e0e0e0;
  margin-top: 16rpx;
}

.cancel-btn::after {
  border: none;
}

/* 评价列表 */
.review-list {
  margin: 0 24rpx;
}

.review-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.review-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.review-rating {
  margin-left: auto;
  color: #FFB800;
  font-size: 24rpx;
}

.review-comment {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.review-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.review-tag {
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.review-time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 12rpx;
}
