/* 全局样式 - 参考"粗门"极简设计 */
page {
  background-color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}

input, textarea {
  font-family: inherit;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 主色调 - 参考"粗门"绿色 */
:root {
  --primary: #00C853;
  --primary-light: #E8F5E9;
  --text: #1a1a1a;
  --text-secondary: #666;
  --text-light: #999;
  --bg: #fff;
  --border: #f0f0f0;
}

/* 页面容器 */
.container {
  min-height: 100vh;
  background: #fff;
}

/* 通用卡片 - 无边框设计 */
.card {
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 28rpx;
}

.card:last-child {
  border-bottom: none;
}

/* 头部 - 简洁绿色 */
.header {
  background: #00C853;
  color: #fff;
  padding: 40rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  display: block;
}

/* 通用按钮 */
.btn {
  background: #00C853;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #00C853;
  border: 2rpx solid #00C853;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: #999;
}

/* 区块 */
.section {
  margin: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 28rpx 10rpx;
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 搜索栏 */
.search-bar {
  margin: 20rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 0;
  background: #fff;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 20rpx;
}

.category-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.category-item.active {
  background: #00C853;
  color: #fff;
}
