/* 编辑资料样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: 40rpx;
}

/* 区块 */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 头像编辑 */
.avatar-edit {
  display: flex;
  justify-content: center;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 3rpx solid #00C853;
}

.avatar-placeholder {
  font-size: 70rpx;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
  margin-bottom: 10rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: #00C853;
  margin-top: 10rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 性别选择 */
.gender-selector {
  display: flex;
  gap: 16rpx;
}

.gender-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.gender-btn.active {
  background: #E8F5E9;
  color: #00C853;
  border: 2rpx solid #00C853;
}

/* 兴趣标签 */
.interests {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.interest-tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
}

.interest-tag.selected {
  background: #E8F5E9;
  color: #00C853;
}

/* 保存按钮 */
.save-section {
  padding: 0 24rpx;
  margin-top: 30rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 16rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
}

.save-btn::after {
  border: none;
}

.cancel-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #999;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 2rpx solid #e0e0e0;
}

.cancel-btn::after {
  border: none;
}
