/* 个人中心样式 */
.container {
  min-height: 100vh;
  background: #fff;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar {
  font-size: 50rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.stats {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 36rpx;
  font-weight: 700;
  color: #00C853;
}

.label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.menu {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child {
  border-bottom: none;
}

.icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.item text:nth-child(2) {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  background: #FF5252;
  color: #fff;
  border-radius: 16rpx;
  font-size: 20rpx;
  text-align: center;
  margin-right: 12rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.login-section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  margin-bottom: 20rpx;
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #00C853;
  border: 2rpx dashed #00C853;
  margin-bottom: 16rpx;
}

.avatar-btn::after {
  border: none;
}

.nick-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 80rpx;
  background: #00C853;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.logout-section {
  margin: 20rpx;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  color: #FF5252;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: 2rpx solid #FF5252;
}
