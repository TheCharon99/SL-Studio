<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">⚙️ 设置</text>
  </view>

  <!-- 账户设置 -->
  <view class="section">
    <view class="section-title">账户设置</view>
    <view class="menu">
      <view class="item" bindtap="navToProfile">
        <text class="icon">👤</text>
        <text>个人资料</text>
        <text class="arrow">›</text>
      </view>
      <view class="item" bindtap="navToSecurity">
        <text class="icon">🔒</text>
        <text>账号安全</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section">
    <view class="section-title">通用设置</view>
    <view class="menu">
      <view class="item" bindtap="navToNotification">
        <text class="icon">🔔</text>
        <text>消息通知</text>
        <switch checked="{{notificationEnabled}}" bindchange="onToggleNotification" />
      </view>
      <view class="item" bindtap="navToLocation">
        <text class="icon">📍</text>
        <text>定位权限</text>
        <text class="arrow">›</text>
      </view>
      <view class="item" bindtap="clearCache">
        <text class="icon">🗑️</text>
        <text>清除缓存</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="menu">
      <view class="item" bindtap="navToAbout">
        <text class="icon">ℹ️</text>
        <text>关于我们</text>
        <text class="arrow">›</text>
      </view>
      <view class="item" bindtap="navToPrivacy">
        <text class="icon">📋</text>
        <text>隐私协议</text>
        <text class="arrow">›</text>
      </view>
      <view class="item" bindtap="navToTerms">
        <text class="icon">📄</text>
        <text>用户协议</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 反馈 -->
  <view class="section">
    <view class="section-title">反馈建议</view>
    <view class="menu">
      <view class="item" bindtap="showFeedback">
        <text class="icon">💬</text>
        <text>意见反馈</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <textarea class="feedback-input" placeholder="有什么建议告诉我们..." bindinput="onFeedback" maxlength="200" />
  </view>

  <!-- 版本号 -->
  <view class="version">找搭子 v{{version}}</view>

  <!-- 退出登录 -->
  <view class="logout" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
