<view class="container">
  <view class="header">
    <text class="title">💬 意见反馈</text>
    <text class="subtitle">帮助我们变得更好</text>
  </view>

  <view class="section">
    <view class="section-title">反馈类型</view>
    <picker mode="selector" range="{{categories}}" value="{{category === '' ? -1 : categories.indexOf(category)}}" bindchange="onCategoryChange">
      <view class="picker">
        <text class="picker-text">{{category || '请选择反馈类型'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="section">
    <view class="section-title">反馈内容</view>
    <textarea class="textarea" placeholder="请详细描述您遇到的问题或建议..." value="{{content}}" bindinput="onContentInput" maxlength="500" />
    <text class="char-count">{{content.length}}/500</text>
  </view>

  <view class="section">
    <view class="section-title">上传图片</view>
    <view class="image-list">
      <view wx:for="{{images}}" wx:key="*this" class="image-item">
        <image class="image" src="{{item}}" mode="aspectFill" />
        <text class="delete-btn" bindtap="deleteImage" data-idx="{{index}}">✕</text>
      </view>
      <view class="image-add" bindtap="chooseImage" wx:if="{{images.length < 9}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">联系方式（可选）</view>
    <input class="input" placeholder="手机号或微信号，方便我们联系您" value="{{contact}}" bindinput="onContactInput" />
  </view>

  <view class="submit-section">
    <button class="submit-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交反馈</button>
  </view>
</view>
