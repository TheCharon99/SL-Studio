/* 活动详情样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: 180rpx;
}

/* 顶部信息 */
.hero {
  background: #00C853;
  color: #fff;
  padding: 40rpx 30rpx;
  position: relative;
}

.hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: linear-gradient(to bottom, transparent, #fafafa);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.info-row {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

/* 详情区块 */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 参与者列表 */
.participant {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.participant:last-child {
  border-bottom: none;
}

.participant-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.participant-name {
  font-size: 28rpx;
  color: #333;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  gap: 20rpx;
}

.join-btn {
  flex: 1;
  height: 88rpx;
  background: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.join-btn.joined {
  background: #f5f5f5;
  color: #999;
}

.join-btn::after {
  border: none;
}

.share-btn {
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #00C853;
  color: #00C853;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.share-btn::after {
  border: none;
}
