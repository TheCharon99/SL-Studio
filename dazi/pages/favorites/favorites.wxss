/* 收藏页样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 列表 */
.list {
  padding: 20rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.item-info {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.item-location {
  font-size: 24rpx;
  color: #999;
}

.item-type {
  padding: 6rpx 16rpx;
  background: #E8F5E9;
  color: #00C853;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.item-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.unfavorite-btn {
  margin-left: auto;
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  color: #999;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}
