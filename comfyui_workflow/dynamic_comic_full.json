{
  "_comment": "动态漫画完整工作流 - 角色一致性 + 镜头控制 + 动画化",
  "_version": "1.0",
  "_description": "StoryDiffusion + IP-Adapter + AnimateDiff + ControlNet",
  
  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "_meta": {"title": "加载SDXL模型"},
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    
    "2": {
      "class_type": "CLIPTextEncode",
      "_meta": {"title": "正向提示词"},
      "inputs": {
        "text": "武侠电影风格，大雪纷飞，江南古镇，客栈，水墨画质感，电影光效",
        "clip": ["1", 1]
      }
    },
    
    "3": {
      "class_type": "CLIPTextEncode",
      "_meta": {"title": "负向提示词"},
      "inputs": {
        "text": "低质量，模糊，变形，水印",
        "clip": ["1", 1]
      }
    },
    
    "4": {
      "class_type": "EmptyLatentImage",
      "_meta": {"title": "空Latent"},
      "inputs": {
        "width": 1280,
        "height": 720,
        "batch_size": 1
      }
    },
    
    "5": {
      "class_type": "IPAdapterApply",
      "_meta": {"title": "IP-Adapter角色一致性"},
      "inputs": {
        "ipadapter": ["10", 0],
        "clip_vision": ["11", 0],
        "image": ["参考图节点", 0],
        "model": ["1", 0],
        "weight": 0.8,
        "start_at": 0.0,
        "end_at": 1.0
      }
    },
    
    "6": {
      "class_type": "KSampler",
      "_meta": {"title": "生成图片"},
      "inputs": {
        "seed": 42,
        "steps": 30,
        "cfg": 7.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["5", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    
    "7": {
      "class_type": "VAEDecode",
      "_meta": {"title": "VAE解码"},
      "inputs": {
        "samples": ["6", 0],
        "vae": ["1", 2]
      }
    },
    
    "8": {
      "class_type": "SaveImage",
      "_meta": {"title": "保存图片"},
      "inputs": {
        "filename_prefix": "comic_frame",
        "images": ["7", 0]
      }
    },
    
    "9": {
      "class_type": "ADE_AnimateDiffLoaderWithContext",
      "_meta": {"title": "AnimateDiff加载器"},
      "inputs": {
        "model": ["1", 0],
        "model_name": "mm_sd_v15_v2.ckpt",
        "beta_schedule": "sqrt_linear (AnimateDiff)",
        "motion_scale": 1.0
      }
    },
    
    "10": {
      "class_type": "IPAdapterModelLoader",
      "_meta": {"title": "加载IP-Adapter模型"},
      "inputs": {
        "ipadapter_file": "ip-adapter-plus-face_sdxl_vit-h.safetensors"
      }
    },
    
    "11": {
      "class_type": "CLIPVisionLoader",
      "_meta": {"title": "加载CLIP视觉模型"},
      "inputs": {
        "clip_name": "clip_vision_sdxl.safetensors"
      }
    },
    
    "12": {
      "class_type": "LoadImage",
      "_meta": {"title": "加载参考图"},
      "inputs": {
        "image": "character_reference.png"
      }
    }
  }
}
