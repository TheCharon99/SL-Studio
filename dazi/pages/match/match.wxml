<view class="container">
  <view class="header">
    <text class="title">🎯 推荐搭子</text>
    <text class="sub">基于你的兴趣智能匹配</text>
  </view>
  <view class="list">
    <view wx:for="{{matches}}" wx:key="id" class="card">
      <view class="card-top">
        <text class="avatar">{{item.emoji}}</text>
        <view class="info">
          <text class="name">{{item.name}}</text>
          <text class="dist">📍 {{item.dist}}km · {{item.reason}}</text>
        </view>
      </view>
      <view class="actions">
        <button class="btn-ignore" data-id="{{item.id}}" bindtap="ignore">忽略</button>
        <button class="btn-join" data-id="{{item.id}}" data-activityid="{{item.activityId}}" bindtap="goToMatchRequest">申请</button>
      </view>
    </view>
  </view>
  <view wx:if="{{matches.length === 0}}" class="empty">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">暂无更多匹配</text>
  </view>
</view>
