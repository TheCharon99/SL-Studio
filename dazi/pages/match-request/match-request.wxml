<view class="container">
  <view class="header">
    <text class="title">🤝 申请匹配</text>
    <text class="subtitle">{{activityTitle}}</text>
  </view>

  <view class="section">
    <view class="section-title">活动信息</view>
    <view class="info-item">
      <text class="info-label">活动时间</text>
      <text class="info-value">请查看活动详情</text>
    </view>
    <view class="info-item">
      <text class="info-label">活动地点</text>
      <text class="info-value">请查看活动详情</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">申请理由</view>
    <textarea class="textarea" placeholder="向活动发起人说明为什么想加入这个活动..." value="{{matchReason}}" bindinput="onReasonInput" maxlength="200" />
    <text class="char-count">{{matchReason.length}}/200</text>
  </view>

  <view class="submit-section">
    <button class="submit-btn" bindtap="submitMatch" loading="{{submitting}}" disabled="{{submitting}}">发送申请</button>
  </view>
</view>
