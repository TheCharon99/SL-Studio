{
  "_comment": "武侠动态漫画工作流 - SDXL生成图片 + AnimateDiff动画化 + 镜头运动控制",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "加载SDXL模型"
    },
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "正向提示词"
    },
    "inputs": {
      "text": "武侠电影风格，大雪纷飞，江南古镇客栈，中国古风，\n水墨画质感，电影光效，氛围压抑神秘，冷蓝灰色调，\n窗外风雪，炉火微弱，\n--ar 16:9",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "负向提示词"
    },
    "inputs": {
      "text": "低质量，模糊，变形，水印，oversaturated, ugly, bad anatomy",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "空Latent"
    },
    "inputs": {
      "width": 1280,
      "height": 720,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": {
      "title": "生成图片"
    },
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "1",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE解码"
    },
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "保存图片"
    },
    "inputs": {
      "filename_prefix": "wuxia_comic",
      "images": [
        "6",
        0
      ]
    }
  },
  "8": {
    "class_type": "ADE_AnimateDiffLoaderWithContext",
    "_meta": {
      "title": "AnimateDiff加载器"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "model_name": "mm_sd_v15_v2.ckpt",
      "beta_schedule": "sqrt_linear (AnimateDiff)",
      "motion_scale": 1.0,
      "apply_v2_models_properly": true
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "视频合并"
    },
    "inputs": {
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "wuxia_animated",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "images": [
        "6",
        0
      ]
    }
  }
}