/* 设置页样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

/* 区块 */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 24rpx 8rpx;
}

/* 菜单 */
.menu {
  padding: 0 24rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child {
  border-bottom: none;
}

.icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.item text:nth-child(2) {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.value {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 反馈输入 */
.feedback-input {
  width: calc(100% - 48rpx);
  margin: 16rpx 24rpx;
  height: 140rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 版本 */
.version {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 30rpx 0;
}

/* 退出登录 */
.logout {
  padding: 0 24rpx 30rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #FF5252;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 2rpx solid #FF5252;
}

.logout-btn::after {
  border: none;
}
