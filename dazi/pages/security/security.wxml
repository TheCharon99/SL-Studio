<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">🔒 账号安全</text>
  </view>

  <!-- 修改密码 -->
  <view class="section">
    <view class="section-title">修改密码</view>
    <view class="form-item">
      <text class="label">新密码</text>
      <view class="password-input">
        <input class="input" type="{{passwordVisible ? 'text' : 'password'}}" placeholder="请输入新密码" value="{{newPassword}}" bindinput="onNewPasswordInput" maxlength="20" />
        <text class="eye-icon" bindtap="onTogglePassword">{{passwordVisible ? '👁️' : '👁️‍🗨️'}}</text>
      </view>
    </view>
    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" maxlength="20" />
    </view>
    <button class="save-btn" bindtap="changePassword" loading="{{saving}}" disabled="{{saving}}">确认修改</button>
  </view>

  <!-- 安全提示 -->
  <view class="section">
    <view class="section-title">安全提示</view>
    <view class="tips">
      <view wx:for="{{tips}}" wx:key="title" class="tip-item">
        <text class="tip-icon">{{item.icon}}</text>
        <view class="tip-content">
          <text class="tip-title">{{item.title}}</text>
          <text class="tip-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 隐私设置 -->
  <view class="section">
    <view class="section-title">隐私设置</view>
    <view class="menu">
      <view class="item">
        <text class="icon">👤</text>
        <text>谁可以看到我的动态</text>
        <text class="value">所有人</text>
        <text class="arrow">›</text>
      </view>
      <view class="item">
        <text class="icon">🔔</text>
        <text>谁可以联系我</text>
        <text class="value">所有人</text>
        <text class="arrow">›</text>
      </view>
      <view class="item">
        <text class="icon">📍</text>
        <text>位置信息</text>
        <switch bindchange="toggleLocation" />
      </view>
    </view>
  </view>
</view>
