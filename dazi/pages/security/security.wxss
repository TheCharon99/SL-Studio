/* 安全设置样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

/* 区块 */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.password-input {
  position: relative;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 90rpx 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.eye-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-top: 24rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
}

.save-btn::after {
  border: none;
}

/* 安全提示 */
.tips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-content {
  flex: 1;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.tip-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* 菜单 */
.menu {
  display: flex;
  flex-direction: column;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child {
  border-bottom: none;
}

.icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.item text:nth-child(2) {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.value {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}
