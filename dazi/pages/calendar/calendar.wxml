<view class="container">
  <view class="header">
    <text class="title">📅 活动日历</text>
    <text class="subtitle">查看每月活动安排</text>
  </view>

  <view class="calendar">
    <view class="calendar-header">
      <text class="nav-btn" bindtap="prevMonth">‹</text>
      <text class="month-title">{{currentDate.getFullYear()}}年{{currentDate.getMonth() + 1}}月</text>
      <text class="nav-btn" bindtap="nextMonth">›</text>
    </view>

    <view class="weekdays">
      <text wx:for="['一', '二', '三', '四', '五', '六', '日']" wx:key="*this" class="weekday">{{item}}</text>
    </view>

    <view class="days">
      <view 
        wx:for="{{calendar}}" 
        wx:key="dateStr"
        class="day {{item.isCurrentMonth ? 'current' : 'other'}} {{item.isToday ? 'today' : ''}} {{item.hasActivity ? 'has-activity' : ''}} {{selectedDate === item.dateStr ? 'selected' : ''}}"
        bindtap="selectDate"
        data-date="{{item.dateStr}}"
      >
        <text class="day-num">{{item.date}}</text>
        <text wx:if="{{item.hasActivity}}" class="activity-dot"></text>
      </view>
    </view>
  </view>

  <view class="activities-section" wx:if="{{selectedDate}}">
    <view class="section-title">
      <text>{{selectedDate}} 的活动</text>
      <text class="count" wx:if="{{selectedActivities.length > 0}}">{{selectedActivities.length}}个</text>
    </view>
    
    <view wx:if="{{selectedActivities.length > 0}}" class="activity-list">
      <view 
        wx:for="{{selectedActivities}}" 
        wx:key="id"
        class="activity-item"
        bindtap="goToActivity"
        data-id="{{item.id}}"
      >
        <view class="activity-info">
          <text class="activity-emoji">{{item.type === '美食' ? '🍜' : item.type === '运动' ? '🏃' : item.type === '娱乐' ? '🎭' : '📚'}}</text>
          <view class="activity-text">
            <text class="activity-name">{{item.title}}</text>
            <text class="activity-time">{{item.time}}</text>
          </view>
        </view>
        <text class="activity-tag">{{item.type}}</text>
      </view>
    </view>
    
    <view wx:else class="empty-activities">
      <text class="empty-icon">📭</text>
      <text class="empty-text">当天没有活动</text>
    </view>
  </view>

  <view class="legend">
    <view class="legend-item">
      <view class="legend-dot today-dot"></view>
      <text>今天</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot activity-dot"></view>
      <text>有活动</text>
    </view>
  </view>
</view>
