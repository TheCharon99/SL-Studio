/* 首页样式 */
.container {
  min-height: 100vh;
  background: #fff;
}

/* 头部 */
.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
  text-align: center;
}

.logo {
  font-size: 72rpx;
  display: block;
  margin-bottom: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 搜索 */
.search-bar {
  margin: -20rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

/* 分类 */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 20rpx;
}

.category-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  display: inline-block;
}

.category-item.active {
  background: #00C853;
  color: #fff;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx;
}

.activity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  font-size: 48rpx;
  margin-right: 16rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.location {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.type-tag {
  padding: 6rpx 16rpx;
  background: #E8F5E9;
  color: #00C853;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.card-content {
  margin-bottom: 16rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.activity-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #666;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #666;
}

.join-btn {
  padding: 12rpx 32rpx;
  background: #00C853;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.join-btn::after {
  border: none;
}

.favorite-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 36rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: #999;
}
