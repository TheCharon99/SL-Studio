/* 日历样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

/* 日历 */
.calendar {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.weekdays {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.weekday {
  font-size: 24rpx;
  color: #999;
  width: 14.28%;
  text-align: center;
}

.days {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.day {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  border-radius: 12rpx;
}

.day.other-month {
  color: #ccc;
}

.day.today {
  background: #E8F5E9;
  color: #00C853;
  font-weight: 700;
}

.day.has-activity {
  position: relative;
}

.day.has-activity::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #00C853;
  border-radius: 50%;
}

.day.selected {
  background: #00C853;
  color: #fff;
}

/* 活动列表 */
.activities {
  padding: 0 20rpx;
}

.activity-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.activity-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.activity-info {
  flex: 1;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.activity-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.activity-type {
  padding: 6rpx 16rpx;
  background: #E8F5E9;
  color: #00C853;
  border-radius: 12rpx;
  font-size: 22rpx;
}

/* 导航 */
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
}

.nav-btn {
  font-size: 32rpx;
  color: #00C853;
  padding: 16rpx 32rpx;
  background: #E8F5E9;
  border-radius: 24rpx;
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
