/* 评论页样式 - 参考"粗门"设计 */
.container {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  padding: 40rpx 30rpx 30rpx;
  background: #00C853;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 输入区域 */
.input-section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input-wrapper {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.textarea {
  flex: 1;
  min-height: 80rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  max-height: 200rpx;
}

.send-btn {
  padding: 16rpx 28rpx;
  background: #00C853;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  border: none;
}

.send-btn::after {
  border: none;
}

.send-btn:disabled {
  background: #ccc;
}

/* 评论列表 */
.comment-list {
  padding: 0 20rpx;
}

.comment-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #ccc;
  margin-left: auto;
}

.comment-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.comment-reply {
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.reply-header {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.4;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
