<view class="container">
  <view class="header">
    <text class="title">📋 我的活动</text>
  </view>

  <view class="empty" wx:if="{{activities.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无参与的活动</text>
    <button class="btn" bindtap="goToDiscover">去发现</button>
  </view>

  <view class="activity-list" wx:else>
    <view 
      wx:for="{{activities}}" 
      wx:key="id"
      class="activity-card"
    >
      <view class="card-header">
        <text class="avatar">{{item.emoji}}</text>
        <view class="user-info">
          <text class="username">{{item.username}}</text>
          <text class="location">{{item.location}}</text>
        </view>
        <view class="type-tag">{{item.type}}</view>
      </view>
      
      <view class="card-content">
        <text class="activity-title">{{item.title}}</text>
        <view class="activity-meta">
          <text class="time">🕐 {{item.time}}</text>
          <text class="people">👥 {{item.people}}</text>
        </view>
      </view>

      <view class="card-footer">
        <button class="details-btn" data-id="{{item.id}}" bindtap="goToDetail">查看详情</button>
        <button class="cancel-btn" data-id="{{item.id}}" bindtap="cancelJoin">取消报名</button>
      </view>
    </view>
  </view>
</view>
