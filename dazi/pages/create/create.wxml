<view class="container">
  <view class="header">
    <text class="title">✨ 发布活动</text>
    <text class="subtitle">描述你想做的事，找志同道合的人</text>
  </view>
  
  <view class="form">
    <view class="form-item">
      <text class="label">活动标题</text>
      <input class="input" placeholder="请输入活动标题" value="{{title}}" bindinput="onTitleInput" />
    </view>
    
    <view class="form-item">
      <text class="label">活动类型</text>
      <view class="types">
        <view 
          wx:for="{{types}}" 
          wx:key="*this"
          class="type {{type === item ? 'active' : ''}}"
          bindtap="selectType"
          data-type="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">活动地点</text>
      <input class="input" placeholder="如：上海·静安区" value="{{location}}" bindinput="onLocationInput" />
    </view>
    
    <view class="form-item">
      <text class="label">详细地址</text>
      <input class="input" placeholder="如：南京西路1266号恒隆广场" value="{{address}}" bindinput="onAddressInput" />
    </view>
    
    <view class="form-item">
      <text class="label">活动时间</text>
      <view class="datetime-row">
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="picker">{{date || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="picker">{{time || '选择时间'}}</view>
        </picker>
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">最多人数</text>
      <input class="input num-input" type="digit" placeholder="4" value="{{maxPeople}}" bindinput="onMaxPeopleChange" />
    </view>
    
    <view class="form-item">
      <text class="label">活动描述</text>
      <textarea class="textarea" placeholder="详细描述活动内容和要求..." value="{{description}}" bindinput="onDescriptionInput" maxlength="200"></textarea>
    </view>
    
    <button class="btn" bindtap="publish" loading="{{publishing}}" disabled="{{publishing}}">发布活动</button>
  </view>
</view>
